# =========================================================================
# CyrillicFontTransfer - Environment Variables Configurations (TEMPLATE)
# =========================================================================

# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit your actual '.env' file to GitHub.

# --- HTX API Credentials ---
# Generate these on the HTX Exchange under profile -> "API Management" (API Key)
# Make sure the API key has 'Read' (History/Deposits) permission checked.
HTX_ACCESS_KEY=your_htx_access_key_here
HTX_SECRET_KEY=your_htx_secret_key_here

# --- Your Deposit Addresses ---
# Users will transfer USDT to these addresses. Enter your personal deposit addresses from HTX.
HTX_USDT_TRC20=TYourTRC20DepositAddressHere...
HTX_USDT_ERC20=0xYourERC20DepositAddressHere...
HTX_USDT_BEP20=0xYourBEP20DepositAddressHere...
